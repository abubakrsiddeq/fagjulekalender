# ---------------------------------------------------------------
# Fagjulekalender – environment variables
# Copy to .env.local for local development. On Hostinger, add the
# same keys under your Node.js app → Environment variables.
# ---------------------------------------------------------------

# MySQL / MariaDB (Hostinger: hPanel → Databases → MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_fagjul
DB_PASSWORD=change-me
DB_NAME=u123456789_fagjul
DB_POOL_SIZE=10
# Set to true if your database host requires TLS (e.g. remote access from another provider).
DB_SSL=false

# Public URL of the app, no trailing slash. Used in e-mails and cookie settings.
APP_URL=https://julekalender.example.no

# Long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# Organization row to use (database/seed.sql creates id 1).
ORG_ID=1

# Comma-separated. These people get the admin role when they sign in and
# can always sign in, even if their domain is not on the allowed list.
ADMIN_EMAILS=you@example.no

# SMTP for sign-in codes and daily reminders (Hostinger e-mail: smtp.hostinger.com, port 465).
# Leave SMTP_HOST empty in development: e-mails are printed to the terminal instead.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@example.no
SMTP_PASSWORD=change-me
SMTP_FROM="Fagjulekalender <no-reply@example.no>"

# Secret for the cron endpoint (/api/cron?key=...). Long random string.
CRON_SECRET=replace-with-another-long-random-string

# Local testing only: print e-mails (including sign-in codes) to the server log instead of sending.
# Never set this in production.
MAIL_LOG_ONLY=false
